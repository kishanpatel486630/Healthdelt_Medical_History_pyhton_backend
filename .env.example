# ──────────────────────────────────────────────────────────────
#  Healthdelt Medical History — Python Backend
#  Environment Variables — Render Production Template
#
#  Copy this file or paste each variable into Render's
#  "Environment" tab under your Web Service settings.
#  DO NOT commit the actual .env file to Git.
# ──────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────
# For Render, use a PostgreSQL database (Render Free Tier available)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Get this from: Render Dashboard → your PostgreSQL service → Connection String (Internal)
DATABASE_URL=postgresql://healthdelt_user:your_password@dpg-xxxxxxxx-a/healthdelt_db


# ── JWT Secrets ───────────────────────────────────────────────
# Must match the secrets used in any Node.js backend for token compatibility
# Use strong random strings in production (min 32 chars recommended)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=healthdelt-access-secret-k9x7m2p4q8w1
JWT_REFRESH_SECRET=healthdelt-refresh-secret-j3n5v8b6t0y2


# ── JWT Token Expiry ──────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Server ────────────────────────────────────────────────────
# Render automatically sets PORT — do not hardcode in production
# Leave this as 10000 (Render's default) or remove it entirely
PORT=5002

# Your deployed frontend URL (used for CORS allow_origins)
# Example: https://healthdelt.onrender.com or your custom domain
CLIENT_URL= https://healthdelt-tracker.vercel.app


# ── File Uploads ──────────────────────────────────────────────
# Render's filesystem is ephemeral — use a persistent storage service
# (e.g., Cloudinary, AWS S3, or Render Disk) for production uploads.
# For now, this points to the local uploads directory.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760


# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=production
